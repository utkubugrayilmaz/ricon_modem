# Bu dosyayi .env olarak kopyalayip doldur. .env ASLA commit edilmez.
# Calistirma:  node --env-file=.env ricon.js oku
#
# Buradaki her ad araclta aynen bu sekilde okunur; .env ile .env.example
# her zaman ayni ad kumesini tasimali.

# Modemin IP adresi. Fabrika varsayilani 192.168.1.1.
MODEM_HOST=192.168.1.1

# Web paneli kimligi (HTTP Basic). Cihazin altindaki etikette yazili olabilir.
# Kimliksiz sadece sistem bilgisi alinir; SIM/ayar/nvram icin gerekli.
MODEM_KULLANICI=
MODEM_SIFRE=

# Giden isteklerin cikacagi yerel kaynak IP. Modemle ayni alt agda olan
# ikincil adresi verin (or. 192.168.1.50). Windows'ta -SkipAsSource ile
# eklenen adres varsayilan kaynak secilmez; bunu vererek dogru arayuzden
# cikilir. Bos birakilirsa isletim sistemi karar verir.
MODEM_KAYNAK_IP=

