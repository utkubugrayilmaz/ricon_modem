# Bu dosyayi .env olarak kopyalayip doldur. .env ASLA commit edilmez.
# Calistirma:  node --env-file=.env bin/ricon.js read     (ya da: npm run read)
#
# Buradaki her ad aracta aynen bu sekilde okunur; .env ile .env.example
# her zaman ayni ad kumesini tasimali.
#
# v0.2.0'da uc ad degisti. Eskisi HALA OKUNUR ama stderr'a bir kere
# "deprecated" yazar — data/ gibi .env de her makinede ayri duruyor ve
# repo guncellemesiyle kendiliginden degismiyor:
#   MODEM_KULLANICI  -> MODEM_USER
#   MODEM_SIFRE      -> MODEM_PASSWORD
#   MODEM_KAYNAK_IP  -> MODEM_SOURCE_IP

# Modemin IP adresi. Fabrika varsayilani 192.168.1.1.
MODEM_HOST=192.168.1.1

# Web paneli kimligi (HTTP Basic). Cihazin altindaki etikette yazili olabilir.
# Kimliksiz sadece sistem bilgisi alinir; SIM/ayar/nvram icin gerekli.
MODEM_USER=
MODEM_PASSWORD=

# Modemin takili oldugu ag adaptorunun adi. BOS birakilirsa arac kendi bulur
# (kablolu gorunumlu adlar once: enp3s0, eno1, Ethernet...). Sabit bir "eth0"
# varsayimi Linux'ta neredeyse hicbir makinede tutmuyor.
MODEM_ADAPTER_NAME=

# DHCP kesfinde kira icin beklenecek sure (saniye). Bos ise 15.
MODEM_DHCP_TIMEOUT_SEC=

# Giden isteklerin cikacagi yerel kaynak IP. Modemle ayni alt agda olan
# ikincil adresi verin (or. 192.168.1.50). Windows'ta -SkipAsSource ile
# eklenen adres varsayilan kaynak secilmez; bunu vererek dogru arayuzden
# cikilir. Bos birakilirsa isletim sistemi karar verir.
MODEM_SOURCE_IP=
