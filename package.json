{
  "name": "ricon-modem",
  "version": "0.1.0",
  "description": "Ricon S9922M44 endustriyel hucresel router: okuma ve saha hazirlama (provizyon) otomasyonu",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "ricon": "./bin/ricon.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env bin/ricon.js hazirla --dongu",
    "hazirla": "node --env-file-if-exists=.env bin/ricon.js hazirla",
    "degerlendir": "node --env-file-if-exists=.env bin/ricon.js degerlendir",
    "oku": "node --env-file-if-exists=.env bin/ricon.js oku",
    "dogrula": "node --env-file-if-exists=.env bin/ricon.js dogrula",
    "calistir": "node --env-file-if-exists=.env bin/ricon.js calistir",
    "olcum": "node bin/ricon.js olcum"
  },
