{
  "name": "ricon-modem",
  "version": "0.2.0",
  "description": "Ricon S9922M44 industrial cellular router: read-out and field provisioning automation",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "ricon": "./bin/ricon.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env bin/ricon.js provision --loop",
    "provision": "node --env-file-if-exists=.env bin/ricon.js provision",
    "assess": "node --env-file-if-exists=.env bin/ricon.js assess",
    "read": "node --env-file-if-exists=.env bin/ricon.js read",
    "verify": "node --env-file-if-exists=.env bin/ricon.js verify",
    "call": "node --env-file-if-exists=.env bin/ricon.js call",
    "metrics": "node bin/ricon.js metrics"
  },
  "license": "UNLICENSED",
  "private": true
}
